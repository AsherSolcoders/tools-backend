# --- App ---
APP_NAME=Toolkit Pro
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000

# --- Database (Supabase PostgreSQL) ---
# Falls back to a local SQLite file if unset, so the app runs out of the box.
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/toolkitpro

# --- Temp file processing ---
TMP_UPLOAD_DIR=/tmp/uploads
TMP_RESULT_DIR=/tmp/results
TEMP_FILE_TTL_MINUTES=10
MAX_UPLOAD_MB=50

# --- Permanent storage (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- Public site URL (for sitemap/canonical) ---
SITE_URL=http://localhost:3000
