# =====================================================================
# Toolsimpli — backend config. Copy to .env and fill in.
# =====================================================================

# --- App ---
APP_NAME=Toolsimpli
# development | production  (production locks CORS to CORS_ORIGINS + enables HSTS)
ENVIRONMENT=development
# Generate a strong one for production:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated list of allowed frontend origins (your Vercel URLs in prod).
# e.g. https://yourapp.vercel.app,https://www.yourdomain.com
CORS_ORIGINS=http://localhost:3000

# --- Database ---
# Local Postgres example:
#   postgresql+psycopg2://USER:PASSWORD@localhost:5432/toolkitpro
# Leave unset to use a local SQLite file (zero-config dev).
DATABASE_URL=postgresql+psycopg2://toolkit:toolkit123@localhost:5432/toolkitpro

# --- Public URLs ---
# Public URL of THIS backend (used to build absolute blog-image URLs).
# Set to your https backend URL in production, e.g. https://api.yourdomain.com
API_BASE_URL=
# Public URL of the FRONTEND (used for sitemap.xml / canonical tags).
SITE_URL=http://localhost:3000

# --- Initial admin (seeded on first run if no users exist) ---
ADMIN_EMAIL=admin@toolsimpli.local
# REQUIRED in production. If empty in production, no admin is auto-created.
ADMIN_PASSWORD=

# --- Temp file processing ---
TMP_UPLOAD_DIR=/tmp/uploads
TMP_RESULT_DIR=/tmp/results
TEMP_FILE_TTL_MINUTES=10
MAX_UPLOAD_MB=50

# --- Permanent storage ---
STORAGE_DIR=storage
